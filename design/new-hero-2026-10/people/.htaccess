# /people/ is served by Apache as files, so WordPress never sends its security headers here:
# the same ones (wp/inc/security-headers.json, card #6449). Generated by
# design/new-hero-2026-10/static_headers.py; uploaded by deploy-wp-theme-vimexx.py.
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://coaching.martiendejong.nl https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://secure.gravatar.com https://coaching.martiendejong.nl; font-src 'self' data:; connect-src 'self' https://coaching.martiendejong.nl https://listings.prospergenics.com https://cloudflareinsights.com; frame-src 'self' https://coaching.martiendejong.nl https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; media-src 'self' https://coaching.martiendejong.nl; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# /people/ itself: a real 301 to the members list (card #7226). Generated by
# design/new-hero-2026-10/people/build-profiles.py and uploaded by deploy-wp-theme-vimexx.py;
# the profiles under /people/<slug>/ are not affected. index.html (a meta refresh) is the fallback.
<IfModule mod_alias.c>
RedirectMatch 301 ^/people(/|/index\.html)?$ /members/
</IfModule>
