# Browser caching for the theme's static files (card #7223). Apache reads this from
# wp-content/themes/prospergenics-2026/assets/; it only sets headers, nothing else.
# Without it the host sent no Cache-Control and Cloudflare applied 4 hours.
#   fonts: never change under the same name -> a year, immutable
#   images, CSS, JS: may be replaced under the same name by a deploy -> a day in the browser,
#   2 hours at Cloudflare (s-maxage, as before), so a new image shows up on the next deploy check
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|css|js|json|mp4|webm)$">
    Header set Cache-Control "public, max-age=86400, s-maxage=7200, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>
# The host serves .woff2 without a Content-Type
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
